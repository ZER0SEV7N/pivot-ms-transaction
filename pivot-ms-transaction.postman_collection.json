{
  "info": {
    "_postman_id": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a",
    "name": "Pivot Banking - ms-transaction (Phase II)",
    "description": "Complete Postman Collection for pivot-ms-transaction covering Deposits, Withdrawals (with automatic commission capture), Credit Payments, Credit Consumptions, Inter-Account Bank Transfers, Compensating Reversals, Date-Range Product Reports, and Last 10 Card Movements.",
    "schema": "[https://schema.getpostman.com/json/collection/v2.1.0/collection.json](https://schema.getpostman.com/json/collection/v2.1.0/collection.json)"
  },
  "item": [
    {
      "name": "1. Register Account Deposit (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"transactionId\", jsonData.id);",
              "    pm.collectionVariables.set(\"operationNumber\", jsonData.operationNumber);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"targetProductId\": \"{{sourceAccountId}}\",\n  \"transactionType\": \"DEPOSIT\",\n  \"currency\": \"PEN\",\n  \"amount\": 300.00,\n  \"description\": \"Initial salary deposit\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions",
          "host": ["{{urlMsTransaction}}"],
          "path": ["transactions"]
        }
      }
    },
    {
      "name": "2. Execute Inter-Account Bank Transfer (Phase II - POST /transactions/transfer)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created and type is TRANSFER_OUT\", function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().transactionType).to.eql(\"TRANSFER_OUT\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"sourceAccountId\": \"{{sourceAccountId}}\",\n  \"destinationAccountId\": \"{{destinationAccountId}}\",\n  \"currency\": \"PEN\",\n  \"amount\": 120.00,\n  \"description\": \"Phase II transfer between bank accounts\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions/transfer",
          "host": ["{{urlMsTransaction}}"],
          "path": ["transactions", "transfer"]
        }
      }
    },
    {
      "name": "3. Register Credit Card Consumption (201 Created)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"targetProductId\": \"{{creditCardId}}\",\n  \"transactionType\": \"CREDIT_CONSUMPTION\",\n  \"currency\": \"PEN\",\n  \"amount\": 250.00,\n  \"description\": \"Online electronics purchase\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions",
          "host": ["{{urlMsTransaction}}"],
          "path": ["transactions"]
        }
      }
    },
    {
      "name": "4. Register Credit Card Payment (201 Created)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"targetProductId\": \"{{creditCardId}}\",\n  \"transactionType\": \"CREDIT_PAYMENT\",\n  \"currency\": \"PEN\",\n  \"amount\": 100.00,\n  \"description\": \"Partial monthly credit card payment\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions",
          "host": ["{{urlMsTransaction}}"],
          "path": ["transactions"]
        }
      }
    },
    {
      "name": "5. [Report #1] Generate Product Report by Date Interval (Phase II - Java Streams)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK and report contains movements\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.have.property(\"totalFeesCollected\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{urlMsTransaction}}/transactions/reports/product/{{sourceAccountId}}?startDate=2025-01-01T00:00:00Z&endDate=2027-12-31T23:59:59Z",
          "host": ["{{urlMsTransaction}}"],
          "path": ["transactions", "reports", "product", "{{sourceAccountId}}"],
          "query": [
            { "key": "startDate", "value": "2025-01-01T00:00:00Z" },
            { "key": "endDate", "value": "2027-12-31T23:59:59Z" }
          ]
        }
      }
    },
    {
      "name": "6. [Report #2] Get Last 10 Movements of Credit Card (Phase II - Java Streams)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK and max 10 items returned\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().length).to.be.at.most(10);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{urlMsTransaction}}/transactions/reports/card/{{creditCardId}}/last-movements",
          "host": ["{{urlMsTransaction}}"],
          "path": ["transactions", "reports", "card", "{{creditCardId}}", "last-movements"]
        }
      }
    },
    {
      "name": "7. Reverse Transaction (Compensating Ledger Entry - POST /transactions/{id}/reverse)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Customer requested reversal of duplicate deposit\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions/{{transactionId}}/reverse",
          "host": ["{{urlMsTransaction}}"],
          "path": ["transactions", "{{transactionId}}", "reverse"]
        }
      }
    }
  ],
  "variable": [
    { "key": "urlMsTransaction", "value": "http://localhost:8084/api/v1", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "sourceAccountId", "value": "", "type": "string" },
    { "key": "destinationAccountId", "value": "", "type": "string" },
    { "key": "creditCardId", "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" },
    { "key": "operationNumber", "value": "", "type": "string" }
  ]
}