{
  "info": {
    "_postman_id": "f4a5b6c7-d8e9-4f0a-8b1c-2d3e4f5a6b7c",
    "name": "Pivot Banking - ms-transaction",
    "description": "End-to-End Postman Collection for pivot-ms-transaction (Immutable Financial Ledger: Account Deposits/Withdrawals, Credit Payments/Consumptions, Compensating Reversals, and History Lookups).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Execute Account DEPOSIT (POST /transactions - 201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"depositTxId\", jsonData.id);",
              "    pm.collectionVariables.set(\"depositOpNumber\", jsonData.operationNumber);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{personalCustomerId}}\",\n  \"targetProductId\": \"{{savingsAccountId}}\",\n  \"transactionType\": \"DEPOSIT\",\n  \"currency\": \"PEN\",\n  \"amount\": 300.00,\n  \"description\": \"Ventanilla Cash Deposit - Agencia San Isidro\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions",
          "host": [
            "{{urlMsTransaction}}"
          ],
          "path": [
            "transactions"
          ]
        }
      }
    },
    {
      "name": "2. Execute Account WITHDRAWAL (POST /transactions - 201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"withdrawalTxId\", jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{personalCustomerId}}\",\n  \"targetProductId\": \"{{savingsAccountId}}\",\n  \"transactionType\": \"WITHDRAWAL\",\n  \"currency\": \"PEN\",\n  \"amount\": 100.00,\n  \"description\": \"ATM Withdrawal - Miraflores\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions",
          "host": [
            "{{urlMsTransaction}}"
          ],
          "path": [
            "transactions"
          ]
        }
      }
    },
