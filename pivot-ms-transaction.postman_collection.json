{
  "info": {
    "_postman_id": "d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a",
    "name": "Pivot Banking - ms-transaction (Phase III)",
    "description": "Postman Collection for pivot-ms-transaction (Phase III): ledger entries (deposit, withdrawal, credit payment/consumption, debit card payment/withdrawal, third-party credit payment), inter-account transfers with compensation, compensating reversals, date-range reports and last 10 card movements. The YANKI_PAYMENT entry is created only by the Kafka consumer (yanki.payment.result), not by a REST endpoint. Prerequisites: run ms-customer, ms-account and ms-credit first; set customerId, sourceAccountId, destinationAccountId, creditCardId and debitCardId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register Account Deposit (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"transactionId\", jsonData.id);",
              "    pm.collectionVariables.set(\"operationNumber\", jsonData.operationNumber);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"targetProductId\": \"{{sourceAccountId}}\",\n  \"transactionType\": \"DEPOSIT\",\n  \"currency\": \"PEN\",\n  \"amount\": 300.00,\n  \"description\": \"Initial salary deposit\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions",
          "host": [
            "{{urlMsTransaction}}"
          ],
          "path": [
            "transactions"
          ]
        }
      }
    },
    {
      "name": "2. Execute Inter-Account Bank Transfer (Phase II - POST /transactions/transfer)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created and type is TRANSFER_OUT\", function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().transactionType).to.eql(\"TRANSFER_OUT\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"sourceAccountId\": \"{{sourceAccountId}}\",\n  \"destinationAccountId\": \"{{destinationAccountId}}\",\n  \"currency\": \"PEN\",\n  \"amount\": 120.00,\n  \"description\": \"Phase II transfer between bank accounts\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions/transfer",
          "host": [
            "{{urlMsTransaction}}"
          ],
          "path": [
            "transactions",
            "transfer"
          ]
        }
      }
    },
    {
      "name": "3. Register Credit Card Consumption (201 Created)",
      "request": {
