    {
      "name": "11. Execute Compensating Reversal on Withdrawal (POST /transactions/{id}/reverse)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"ATM cash dispenser error - returning funds to customer account\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions/{{withdrawalTxId}}/reverse",
          "host": [
            "{{urlMsTransaction}}"
          ],
          "path": [
            "transactions",
            "{{withdrawalTxId}}",
            "reverse"
          ]
        }
      }
    },
    {
      "name": "12. [Error 400] Try to Reverse an Already REVERSED Transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Duplicate reversal attempt\"\n}"
        },
        "url": {
          "raw": "{{urlMsTransaction}}/transactions/{{withdrawalTxId}}/reverse",
          "host": [
            "{{urlMsTransaction}}"
          ],
          "path": [
            "transactions",
            "{{withdrawalTxId}}",
            "reverse"
          ]
        }
      }
    }
